; Helmline, the Godot edition (Nov 2026). The browser game in ../public is the reference for
; every rule; this project rebuilds it with a 3D sea, ships and battles.

config_version=5

[application]

config/name="Helmline"
config/description="Age-of-exploration trading and sea fights, 1451-1551."
run/main_scene="res://scenes/chart.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Data="*res://scripts/core/data.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
